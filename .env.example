# Canonical public site URL
NEXT_PUBLIC_SITE_URL="https://3liksir.site"

# Optional: enable Vercel Analytics + Speed Insights
# Set to "true" to inject analytics scripts in production.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS="false"

# Contact form backend gate (API returns 503 unless true)
CONTACT_FORM_ENABLED="false"

# Contact delivery via Resend (required only when CONTACT_FORM_ENABLED=true)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="3liksirdesigns@gmail.com"
CONTACT_FROM_EMAIL="3liksir contact <onboarding@resend.dev>"

