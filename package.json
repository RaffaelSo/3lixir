{
  "name": "3liksir-fashion-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run images:sync",
    "dev": "next dev",
    "images:manifest": "node scripts/generate-project-images-manifest.mjs",
    "images:sync": "node scripts/optimize-project-images-phase2.mjs --write && npm run images:manifest",
    "images:prepare": "npm run images:sync",
    "images:optimize": "node scripts/optimize-project-images-phase2.mjs --dry-run",
    "images:optimize:dry": "node scripts/optimize-project-images-phase2.mjs --dry-run",
    "images:optimize:write": "node scripts/optimize-project-images-phase2.mjs --write",
    "images:optimize:replace": "node scripts/optimize-project-images-phase2.mjs --write --replace",
    "prebuild": "npm run images:sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pw:smoke": "node scripts/playwright-smoke.mjs",
    "pw:smoke:live": "PW_SMOKE_URL=https://3liksir.site/en node scripts/playwright-smoke.mjs",
    "verify:quick": "npm run lint && npx tsc --noEmit && npm run pw:smoke"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "12.38.0",
    "next": "16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "workflow": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  }
}
